# Stage 1: Build Go binary from source
FROM golang:1.24-alpine AS builder

ENV GOTOOLCHAIN=auto

RUN apk add --no-cache gcc musl-dev git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build without CGO (no SQLite dependency anymore)
RUN CGO_ENABLED=0 GOOS=linux go build -tags=jsoniter -ldflags="-s -w" -o nginx-ui main.go


# Stage 2: Minimal runtime
FROM alpine:3.20

# IMPORTANT: mysqldump must exist in runtime
RUN apk add --no-cache \
    nginx \
    ca-certificates \
    tzdata \
    bash \
    mysql-client

WORKDIR /app

COPY --from=builder /app/nginx-ui /usr/local/bin/nginx-ui
COPY resources/docker/nginx.conf /etc/nginx/nginx.conf
COPY resources/docker/nginx-ui.conf /etc/nginx/conf.d/nginx-ui.conf

RUN mkdir -p /etc/nginx-ui /var/log/nginx && \
    touch /var/log/nginx/access.log /var/log/nginx/error.log

EXPOSE 9000

CMD ["/usr/local/bin/nginx-ui"]